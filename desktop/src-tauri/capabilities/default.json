{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events, hide, deep links, open links, API calls",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://notaion.runasp.net/*" },
        { "url": "https://localhost:7059/*" }
      ]
    }
  ]
}
