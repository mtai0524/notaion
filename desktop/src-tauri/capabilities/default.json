{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events, hide, deep links, open links, API calls, save exports to Downloads",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://notaion.runasp.net/*"
        },
        {
          "url": "https://localhost:7059/*"
        },
        {
          "url": "https://res.cloudinary.com/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$DOWNLOAD/*"
        }
      ]
    }
  ]
}
